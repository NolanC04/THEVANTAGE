# Public site URL (used for Stripe redirects, ID.me callback, email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (auth, Postgres, RLS). Without these, the app runs on a local dev store in .data/ (development only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin: the author of record. Only this email can publish drafts.
VANTAGE_ADMIN_EMAIL=

# Stripe (test mode until launch)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LIBRARY_MONTHLY=
STRIPE_PRICE_COHORT=
STRIPE_PRICE_COHORT_FOUNDING=
# Coupon applied for verified military spouses. Amount is [NOLAN: amount]; create the coupon in Stripe and paste its ID.
STRIPE_COUPON_MILITARY_SPOUSE=

# Military / veteran verification (ID.me OAuth). Documents are never collected or stored.
IDME_CLIENT_ID=
IDME_CLIENT_SECRET=
IDME_ENV=sandbox

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="The Vantage <hello@[NOLAN: sending domain]>"
INQUIRY_TO_EMAIL=

# Studiolo import (studiolo.vantage/1 packages, HMAC-SHA256)
VANTAGE_IMPORT_SECRET=

# Claude API (GENE in the member library)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Locked prompts live in NolanC04/SIGNETOPS. GENE's prompt is fetched from there; never copied into this repo.
SIGNETOPS_RAW_BASE=https://raw.githubusercontent.com/NolanC04/SIGNETOPS/main
GITHUB_TOKEN=

# ---- The Airman Vantage (/airman): the facilitated military segment. Same Supabase project as above. ----
# Nolan's sign-in email: becomes the segment's admin on first sign-in; this row can't be demoted.
APEX_ADMIN_EMAIL=
# Sender for segment notifications (non-.mil domain; test that .mil inboxes accept it before go-live)
NOTIFY_FROM="AAPEX <notify@[NOLAN: domain]>"
DISCORD_INVITE_URL=
# studiolo.apex/1 packages (shared with Studiolo)
APEX_IMPORT_SECRET=
# GENE validation: pin the prompt to a SIGNETOPS commit SHA before T-0 so every pilot score uses the same prompt.
GENE_PROMPT_REF=
# Bump when the rubric anchors in lib/airman/validation.ts change.
GENE_RUBRIC_VERSION=v1
